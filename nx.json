{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "master",
  "namedInputs": {
    "default": [
      "{projectRoot}/**/*",
      "sharedGlobals"
    ],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/.eslintrc.json",
      "!{projectRoot}/src/test-setup.[jt]s",
      "!{projectRoot}/test-setup.[jt]s"
    ],
    "sharedGlobals": []
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "build": {
          "targetName": "build",
          "configName": "tsconfig.lib.json"
        },
        "analyzeSourceFiles": true
      }
    },
    {
      "plugin": "@nx/jest/plugin",
      "options": {
        "targetName": "test"
      }
    },
    {
      "plugin": "./packages/maven/dist",
      "options": {
        "atomizeTests": true,
        "minTestClassesForAtomization": 1
      }
    }
  ],
  "release": {
    "groups": {
      "maven": {
        "projects": [
          "@nx/maven"
        ],
        "version": {
          "generatorOptions": {
            "currentVersionResolver": "git-tag"
          },
          "git": {
            "commitMessage": "chore: release maven {version}",
            "tagMessage": "release(maven): {version}"
          }
        }
      }
    },
    "projectsRelationship": "independent",
    "version": {
      "generatorOptions": {
        "currentVersionResolver": "git-tag",
        "fallbackCurrentVersionResolver": "disk"
      },
      "projects": {
        "@nx/maven": {
          "generatorOptions": {
            "packageRoot": "packages/maven",
            "currentVersionResolverMetadata": {
              "tag": "@nx/maven-{version}",
              "tagVersionPrefix": "@nx/maven-"
            }
          }
        },
        "maven-analyzer-plugin": {
          "generatorOptions": {
            "packageRoot": "packages/maven/analyzer-plugin",
            "currentVersionResolverMetadata": {
              "tag": "maven-analyzer-plugin-{version}",
              "tagVersionPrefix": "maven-analyzer-plugin-"
            }
          }
        }
      }
    },
    "changelog": {
      "workspaceChangelog": {
        "createRelease": "github"
      },
      "projectChangelogs": {
        "createRelease": "github"
      },
      "git": {
        "commitMessage": "chore: update changelog for {version}",
        "tagMessage": "changelog: {version}"
      }
    }
  }
}
