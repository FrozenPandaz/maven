{
  "$schema": "./node_modules/nx/schemas/nx-schema.json",
  "defaultBase": "master",
  "targetDefaults": {
    "build": {
      "cache": true,
      "dependsOn": ["^build"],
      "inputs": ["production", "^production"]
    },
    "test": {
      "cache": true,
      "inputs": ["default", "^production"],
      "outputs": ["{workspaceRoot}/coverage/{projectRoot}"]
    },
    "lint": {
      "cache": true,
      "inputs": ["default"]
    }
  },
  "namedInputs": {
    "default": ["{projectRoot}/**/*", "sharedGlobals"],
    "production": [
      "default",
      "!{projectRoot}/**/?(*.)+(spec|test).[jt]s?(x)?(.snap)",
      "!{projectRoot}/tsconfig.spec.json",
      "!{projectRoot}/jest.config.[jt]s",
      "!{projectRoot}/.eslintrc.json"
    ],
    "sharedGlobals": []
  },
  "plugins": [
    {
      "plugin": "@nx/js/typescript",
      "options": {
        "buildTarget": "build",
        "analyzeSourceFiles": true
      }
    },
    {
      "plugin": "./dist/packages/maven",
      "options": {
        "buildTargetName": "build",
        "testTargetName": "test",
        "verbose": true
      }
    }
  ],
  "release": {
    "groups": {
      "maven": {
        "projects": [
          "@nx/maven",
          "maven-analyzer-plugin"
        ],
        "version": {
          "generatorOptions": {
            "currentVersionResolver": "git-tag"
          },
          "git": {
            "commitMessage": "chore: release maven {version}",
            "tagMessage": "release(maven): {version}"
          }
        }
      }
    },
    "projectsRelationship": "independent",
    "version": {
      "generatorOptions": {
        "currentVersionResolver": "git-tag",
        "fallbackCurrentVersionResolver": "disk"
      },
      "projects": {
        "@nx/maven": {
          "generatorOptions": {
            "packageRoot": "packages/maven",
            "currentVersionResolverMetadata": {
              "tag": "@nx/maven-{version}",
              "tagVersionPrefix": "@nx/maven-"
            }
          }
        },
        "maven-analyzer-plugin": {
          "generatorOptions": {
            "packageRoot": "packages/maven/analyzer-plugin",
            "currentVersionResolverMetadata": {
              "tag": "maven-analyzer-plugin-{version}",
              "tagVersionPrefix": "maven-analyzer-plugin-"
            }
          }
        }
      }
    },
    "changelog": {
      "workspaceChangelog": {
        "createRelease": "github"
      },
      "projectChangelogs": {
        "createRelease": "github"
      },
      "git": {
        "commitMessage": "chore: update changelog for {version}",
        "tagMessage": "changelog: {version}"
      }
    }
  }
}