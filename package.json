{
  "name": "org.apache.maven.maven",
  "version": "0.1.0",
  "private": true,
  "description": "Nx plugin for Maven integration",
  "scripts": {
    "build": "mvn clean install -pl packages/maven/analyzer-plugin -DskipTests && nx build @nx/maven",
    "build:plugin": "cd packages/maven && tsc -b --clean && tsc -b tsconfig.lib.json --force",
    "test": "nx test",
    "lint": "nx lint",
    "format": "nx format:write",
    "affected": "nx affected",
    "dep-graph": "nx dep-graph",
    "test-analyzer": "mvn clean install -pl packages/maven/analyzer-plugin -DskipTests && mvn dev.nx.maven:nx-maven-analyzer-plugin:4.1.0-SNAPSHOT:analyze",
    "reset": "nx reset && pnpm build:plugin && pnpm build",
    "release": "pnpm release:version && pnpm nx run maven-analyzer-plugin:sync-maven-version && git add packages/maven/analyzer-plugin/pom.xml && git commit --amend --no-edit",
    "release:version": "nx release version",
    "release:publish": "nx release publish",
    "release:local": "pnpm build && nx release version prerelease && nx release publish"
  },
  "devDependencies": {
    "@nx/devkit": "21.6.1-beta.1",
    "@nx/jest": "21.6.1-beta.1",
    "@nx/js": "21.6.1-beta.1",
    "@nx/plugin": "21.6.1-beta.1",
    "@nx/workspace": "21.6.1-beta.1",
    "@types/node": "^20.0.0",
    "jest": "^30.0.2",
    "nx": "21.6.1-beta.1",
    "tslib": "^2.3.0",
    "typescript": "^5.0.0",
    "verdaccio": "^6.1.6"
  },
  "nx": {
    "name": "org.apache.maven.maven"
  },
  "packageManager": "pnpm@9.15.0"
}
